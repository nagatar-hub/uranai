{
  "expo": {
    "name": "おみくじ",
    "slug": "omikuji",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "omikuji",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5F0E8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nagatar.omikuji"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      },
      "package": "com.nagatar.omikuji"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
